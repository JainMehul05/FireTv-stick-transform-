<?xml version="1.0" encoding="utf-8"?>
<!-- Premium App Tile Background for Installed Apps Shelf -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#2500D4FF" />
                    <corners android:radius="20dp" />
                    <padding android:left="3dp" android:top="3dp" android:right="3dp" android:bottom="3dp" />
                </shape>
            </item>
            <item android:left="3dp" android:top="3dp" android:right="3dp" android:bottom="3dp">
                <shape android:shape="rectangle">
                    <gradient
                        android:angle="270"
                        android:startColor="#3016243A"
                        android:endColor="#400E182A" />
                    <stroke android:width="1.8dp" android:color="#E6FFFFFF" />
                    <corners android:radius="18dp" />
                </shape>
            </item>
        </layer-list>
    </item>

    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#20121A26"
                android:endColor="#300C121E" />
            <stroke android:width="1dp" android:color="#18FFFFFF" />
            <corners android:radius="18dp" />
        </shape>
    </item>
</selector>
