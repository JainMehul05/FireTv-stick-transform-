<?xml version="1.0" encoding="utf-8"?>
<!-- Wallpaper grid item background -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/focus_glow_strong" />
                    <corners android:radius="@dimen/radius_lg" />
                    <padding android:left="4dp" android:top="4dp" android:right="4dp" android:bottom="4dp" />
                </shape>
            </item>
            <item android:left="4dp" android:top="4dp" android:right="4dp" android:bottom="4dp">
                <shape android:shape="rectangle">
                    <stroke android:width="2dp" android:color="@color/focus_primary" />
                    <corners android:radius="@dimen/radius_lg" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <shape android:shape="rectangle">
            <stroke android:width="1dp" android:color="@color/border_subtle" />
            <corners android:radius="@dimen/radius_lg" />
        </shape>
    </item>
</selector>