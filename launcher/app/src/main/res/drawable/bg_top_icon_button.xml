<?xml version="1.0" encoding="utf-8"?>
<!-- Premium frosted glass icon button for top bar (Inputs, Settings) -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Focused: bright glass with accent glow -->
    <item android:state_focused="true">
        <layer-list>
            <!-- Outer glow -->
            <item>
                <shape android:shape="oval">
                    <solid android:color="@color/focus_glow_strong" />
                    <padding android:left="3dp" android:top="3dp" android:right="3dp" android:bottom="3dp" />
                </shape>
            </item>
            <!-- Main button -->
            <item android:left="3dp" android:top="3dp" android:right="3dp" android:bottom="3dp">
                <shape android:shape="oval">
                    <gradient
                        android:angle="270"
                        android:startColor="#40FFFFFF"
                        android:centerColor="#26FFFFFF"
                        android:endColor="#14FFFFFF" />
                    <stroke android:width="1.5dp" android:color="@color/focus_primary" />
                </shape>
            </item>
            <!-- Inner highlight (top ~40%) -->
            <item android:left="5dp" android:top="5dp" android:right="5dp" android:bottom="18dp">
                <shape android:shape="oval">
                    <gradient
                        android:angle="270"
                        android:startColor="#33FFFFFF"
                        android:endColor="#00FFFFFF" />
                </shape>
            </item>
        </layer-list>
    </item>

    <!-- Pressed: slightly darker -->
    <item android:state_pressed="true">
        <layer-list>
            <item>
                <shape android:shape="oval">
                    <gradient
                        android:angle="270"
                        android:startColor="#26FFFFFF"
                        android:centerColor="#1AFFFFFF"
                        android:endColor="#0DFFFFFF" />
                    <stroke android:width="1dp" android:color="@color/border_default" />
                </shape>
            </item>
            <item android:left="2dp" android:top="2dp" android:right="2dp" android:bottom="12dp">
                <shape android:shape="oval">
                    <gradient
                        android:angle="270"
                        android:startColor="#1AFFFFFF"
                        android:endColor="#00FFFFFF" />
                </shape>
            </item>
        </layer-list>
    </item>

    <!-- Default: subtle frosted glass -->
    <item>
        <layer-list>
            <item>
                <shape android:shape="oval">
                    <gradient
                        android:angle="270"
                        android:startColor="#1AFFFFFF"
                        android:centerColor="#0DFFFFFF"
                        android:endColor="#08FFFFFF" />
                    <stroke android:width="1dp" android:color="@color/border_subtle" />
                </shape>
            </item>
            <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="12dp">
                <shape android:shape="oval">
                    <gradient
                        android:angle="270"
                        android:startColor="#10FFFFFF"
                        android:endColor="#00FFFFFF" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>