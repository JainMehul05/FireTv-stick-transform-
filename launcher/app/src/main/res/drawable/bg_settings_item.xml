<?xml version="1.0" encoding="utf-8"?>
<!-- Premium settings item background -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Focused: bright glass with accent glow -->
    <item android:state_focused="true">
        <layer-list>
            <!-- Outer glow -->
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/focus_glow" />
                    <corners android:radius="@dimen/radius_md" />
                    <padding android:left="2dp" android:top="2dp" android:right="2dp" android:bottom="2dp" />
                </shape>
            </item>
            <!-- Main item -->
            <item android:left="2dp" android:top="2dp" android:right="2dp" android:bottom="2dp">
                <shape android:shape="rectangle">
                    <gradient
                        android:angle="270"
                        android:startColor="#26FFFFFF"
                        android:centerColor="#1A1E1E30"
                        android:endColor="#12141424" />
                    <stroke android:width="1.5dp" android:color="@color/focus_primary" />
                    <corners android:radius="@dimen/radius_md" />
                </shape>
            </item>
            <!-- Inner highlight (top ~40%) -->
            <item android:left="4dp" android:top="4dp" android:right="4dp" android:bottom="40dp">
                <shape android:shape="rectangle">
                    <gradient
                        android:angle="270"
                        android:startColor="#1AFFFFFF"
                        android:endColor="#00FFFFFF" />
                    <corners
                        android:topLeftRadius="@dimen/radius_md"
                        android:topRightRadius="@dimen/radius_md"
                        android:bottomLeftRadius="0dp"
                        android:bottomRightRadius="0dp" />
                </shape>
            </item>
        </layer-list>
    </item>

    <!-- Pressed: slightly darker -->
    <item android:state_pressed="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <gradient
                        android:angle="270"
                        android:startColor="#1AFFFFFF"
                        android:centerColor="#12FFFFFF"
                        android:endColor="#0DFFFFFF" />
                    <stroke android:width="1dp" android:color="@color/border_default" />
                    <corners android:radius="@dimen/radius_md" />
                </shape>
            </item>
            <item android:left="2dp" android:top="2dp" android:right="2dp" android:bottom="12dp">
                <shape android:shape="rectangle">
                    <gradient
                        android:angle="270"
                        android:startColor="#10FFFFFF"
                        android:endColor="#00FFFFFF" />
                    <corners
                        android:topLeftRadius="@dimen/radius_md"
                        android:topRightRadius="@dimen/radius_md"
                        android:bottomLeftRadius="0dp"
                        android:bottomRightRadius="0dp" />
                </shape>
            </item>
        </layer-list>
    </item>

    <!-- Default: subtle frosted glass -->
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <gradient
                        android:angle="270"
                        android:startColor="#12FFFFFF"
                        android:centerColor="#08FFFFFF"
                        android:endColor="#06FFFFFF" />
                    <stroke android:width="0.5dp" android:color="@color/border_subtle" />
                    <corners android:radius="@dimen/radius_md" />
                </shape>
            </item>
            <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="10dp">
                <shape android:shape="rectangle">
                    <gradient
                        android:angle="270"
                        android:startColor="#0AFFFFFF"
                        android:endColor="#00FFFFFF" />
                    <corners
                        android:topLeftRadius="@dimen/radius_md"
                        android:topRightRadius="@dimen/radius_md"
                        android:bottomLeftRadius="0dp"
                        android:bottomRightRadius="0dp" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>