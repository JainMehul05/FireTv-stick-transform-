<?xml version="1.0" encoding="utf-8"?>
<!-- Glass button for popup menus and sheets -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Focused -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#2EFFFFFF"
                android:centerColor="#1A2A2A3E"
                android:endColor="#141A1A2E" />
            <stroke android:width="1.5dp" android:color="@color/focus_primary" />
            <corners android:radius="@dimen/radius_md" />
        </shape>
    </item>

    <!-- Pressed -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#1AFFFFFF"
                android:centerColor="#0D2A2A3E"
                android:endColor="#081A1A2E" />
            <stroke android:width="1dp" android:color="@color/border_default" />
            <corners android:radius="@dimen/radius_md" />
        </shape>
    </item>

    <!-- Default -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#00000000" />
            <corners android:radius="@dimen/radius_md" />
        </shape>
    </item>
</selector>