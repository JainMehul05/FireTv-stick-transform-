<?xml version="1.0" encoding="utf-8"?>
<!-- Apple TV inspired floating glass platter for the application dock -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Subtle drop shadow -->
    <item
        android:top="4dp"
        android:bottom="0dp"
        android:left="2dp"
        android:right="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <solid android:color="#40000000" />
        </shape>
    </item>

    <!-- Translucent glass base -->
    <item
        android:top="0dp"
        android:bottom="4dp"
        android:left="0dp"
        android:right="0dp">
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <gradient
                android:angle="270"
                android:startColor="#2A203048"
                android:centerColor="#20152238"
                android:endColor="#280D1526" />
            <stroke
                android:width="1dp"
                android:color="#33FFFFFF" />
        </shape>
    </item>

    <!-- Top edge rim reflection -->
    <item
        android:top="0dp"
        android:bottom="80dp"
        android:left="8dp"
        android:right="8dp">
        <shape android:shape="rectangle">
            <corners
                android:topLeftRadius="24dp"
                android:topRightRadius="24dp"
                android:bottomLeftRadius="0dp"
                android:bottomRightRadius="0dp" />
            <gradient
                android:angle="270"
                android:startColor="#25FFFFFF"
                android:endColor="#00FFFFFF" />
        </shape>
    </item>
</layer-list>
