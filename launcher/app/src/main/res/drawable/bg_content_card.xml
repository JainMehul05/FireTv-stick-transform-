<?xml version="1.0" encoding="utf-8"?>
<!-- Premium content card background (Apple TV / Google TV subtle glass styling) -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Focused: subtle glow, refined light border, 12dp rounded corners -->
    <item android:state_focused="true">
        <layer-list>
            <!-- Soft ambient shadow / glow -->
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#2000D4FF" />
                    <corners android:radius="14dp" />
                    <padding android:left="3dp" android:top="3dp" android:right="3dp" android:bottom="3dp" />
                </shape>
            </item>
            <!-- Main card background -->
            <item android:left="3dp" android:top="3dp" android:right="3dp" android:bottom="3dp">
                <shape android:shape="rectangle">
                    <gradient
                        android:angle="270"
                        android:startColor="#2516243A"
                        android:endColor="#350E182A" />
                    <stroke android:width="1.8dp" android:color="#E6FFFFFF" />
                    <corners android:radius="12dp" />
                </shape>
            </item>
            <!-- Subtle top specular highlight -->
            <item android:left="4dp" android:top="4dp" android:right="4dp" android:bottom="70dp">
                <shape android:shape="rectangle">
                    <gradient
                        android:angle="270"
                        android:startColor="#1EFFFFFF"
                        android:endColor="#00FFFFFF" />
                    <corners
                        android:topLeftRadius="11dp"
                        android:topRightRadius="11dp"
                        android:bottomLeftRadius="0dp"
                        android:bottomRightRadius="0dp" />
                </shape>
            </item>
        </layer-list>
    </item>

    <!-- Pressed -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#2A16243A" />
            <stroke android:width="1.2dp" android:color="#80FFFFFF" />
            <corners android:radius="12dp" />
        </shape>
    </item>

    <!-- Default: dark translucent glass surface with subtle border -->
    <item>
        <layer-list>
            <!-- Subtle bottom shadow -->
            <item android:top="2dp">
                <shape android:shape="rectangle">
                    <solid android:color="#20000000" />
                    <corners android:radius="12dp" />
                </shape>
            </item>
            <!-- Main card surface -->
            <item android:bottom="2dp">
                <shape android:shape="rectangle">
                    <gradient
                        android:angle="270"
                        android:startColor="#1A121A26"
                        android:endColor="#280C121E" />
                    <stroke android:width="1dp" android:color="#18FFFFFF" />
                    <corners android:radius="12dp" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
