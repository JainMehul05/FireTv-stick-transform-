<?xml version="1.0" encoding="utf-8"?>
<!-- Wallpaper Picker Activity Layout -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_deep_navy"
    android:fitsSystemWindows="true">

    <!-- Background preview -->
    <ImageView
        android:id="@+id/previewBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:importantForAccessibility="no"
        android:contentDescription="@null" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_hero_scrim" />

    <!-- Top Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/padding_screen_edge_lg"
        android:paddingEnd="@dimen/padding_screen_edge_lg"
        android:paddingTop="@dimen/margin_top_bar">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_4">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/wallpaper"
                    android:textAppearance="@style/TextAppearance.TvHome.Display.Medium" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_1"
                    android:text="Select a background"
                    android:textAppearance="@style/TextAppearance.TvHome.Body"
                    android:textColor="@color/text_tertiary" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnWallpaperBack"
                    style="@style/TvHomeWidgetTopIconButton"
                    android:contentDescription="@string/back"
                    android:drawableStart="@drawable/ic_left"
                    android:layout_marginEnd="@dimen/space_2" />
            </LinearLayout>
        </RelativeLayout>
    </LinearLayout>

    <!-- Wallpaper Grid -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/wallpaperGrid"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="@dimen/space_10"
        android:paddingStart="@dimen/padding_screen_edge"
        android:paddingEnd="@dimen/padding_screen_edge"
        android:paddingBottom="@dimen/space_8"
        android:clipToPadding="false"
        android:clipChildren="false"
        android:overScrollMode="never"
        android:scrollbars="none"
        android:descendantFocusability="afterDescendants" />

    <!-- Apply button (shown when wallpaper selected) -->
    <TextView
        android:id="@+id/btnApplyWallpaper"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal|bottom"
        android:layout_marginBottom="@dimen/space_8"
        android:paddingStart="@dimen/space_6"
        android:paddingEnd="@dimen/space_6"
        android:paddingTop="@dimen/space_2"
        android:paddingBottom="@dimen/space_2"
        android:text="@string/apply"
        android:textAppearance="@style/TextAppearance.TvHome.Button"
        android:background="@drawable/bg_glass_button"
        android:focusable="true"
        android:clickable="true"
        android:visibility="gone" />
</FrameLayout>