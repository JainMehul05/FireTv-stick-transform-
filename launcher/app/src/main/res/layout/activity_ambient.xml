<?xml version="1.0" encoding="utf-8"?>
<!-- Premium Standby / Ambient Screen with Apple TV Clock and Ken Burns Slideshow -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ambientRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:keepScreenOn="true">

    <!-- Dual photo layers for smooth double-buffered Ken Burns crossfades -->
    <ImageView
        android:id="@+id/ambientBack"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:importantForAccessibility="no" />

    <ImageView
        android:id="@+id/ambientFront"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:importantForAccessibility="no" />

    <!-- Cinematic Vignette & Ambient Darkness -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_vignette" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#40000000" />

    <!-- Ambient Typography Overlay (Bottom-Left) -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:orientation="vertical"
        android:layout_marginStart="64dp"
        android:layout_marginBottom="56dp">

        <TextClock
            android:id="@+id/ambientClock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:format12Hour="h:mm"
            android:format24Hour="HH:mm"
            android:textColor="#FFFFFF"
            android:textSize="84sp"
            android:fontFamily="@font/open_sans"
            android:letterSpacing="-0.02"
            android:shadowColor="#80000000"
            android:shadowDx="0"
            android:shadowDy="4"
            android:shadowRadius="12" />

        <TextClock
            android:id="@+id/ambientDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="-8dp"
            android:format12Hour="EEEE, MMMM d"
            android:format24Hour="EEEE, MMMM d"
            android:textColor="#CCFFFFFF"
            android:textSize="20sp"
            android:fontFamily="@font/open_sans"
            android:letterSpacing="0.04"
            android:shadowColor="#80000000"
            android:shadowDx="0"
            android:shadowDy="2"
            android:shadowRadius="8" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Press any remote key to resume"
            android:textColor="#66FFFFFF"
            android:textSize="12sp"
            android:fontFamily="@font/open_sans"
            android:letterSpacing="0.08"
            android:textAllCaps="true" />
    </LinearLayout>

</FrameLayout>
