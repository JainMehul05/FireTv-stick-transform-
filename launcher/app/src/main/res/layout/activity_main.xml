<?xml version="1.0" encoding="utf-8"?>
<!-- Premium Cinematic Home Screen Layout -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_deep_navy"
    android:fitsSystemWindows="true">

    <!-- ===== BACKGROUND LAYER ===== -->
    <!-- Full-screen hero background artwork -->
    <ImageView
        android:id="@+id/heroBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:importantForAccessibility="no"
        android:contentDescription="@null" />

    <!-- Cinematic scrim gradient for text readability -->
    <View
        android:id="@+id/heroScrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_hero_scrim" />

    <!-- Ambient glow from focused dock app (full screen radial) -->
    <View
        android:id="@+id/ambientGlow"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0" />

    <!-- ===== MAIN CONTENT SCROLL VIEW ===== -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/mainContentRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:overScrollMode="never"
        android:scrollbars="none"
        android:clipToPadding="false"
        android:clipChildren="false"
        android:paddingBottom="@dimen/space_8"
        android:descendantFocusability="afterDescendants" />

    <!-- ===== FLOATING GLASS HIGHLIGHT ===== -->
    <!-- Single glass panel that springs between focused grid items -->
    <com.gathin.tvhome.GlassView
        android:id="@+id/glass"
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:alpha="0"
        android:importantForAccessibility="no" />

    <!-- ===== APP LIBRARY GRID (hidden initially, revealed from Apps row) ===== -->
    <FrameLayout
        android:id="@+id/gridContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:visibility="gone">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/grid"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingStart="@dimen/padding_screen_edge"
            android:paddingEnd="@dimen/padding_screen_edge"
            android:paddingTop="@dimen/space_4"
            android:paddingBottom="@dimen/space_8"
            android:clipToPadding="false"
            android:clipChildren="false"
            android:overScrollMode="never"
            android:scrollbars="none"
            android:descendantFocusability="afterDescendants" />
    </FrameLayout>
</FrameLayout>