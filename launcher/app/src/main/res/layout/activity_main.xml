<?xml version="1.0" encoding="utf-8"?>
<!-- Premium Cinematic Home Screen Layout -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_deep_navy"
    android:fitsSystemWindows="true">

    <!-- ===== BACKGROUND LAYER ===== -->
    <!-- Full-screen cinematic hero backdrop -->
    <ImageView
        android:id="@+id/heroBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:importantForAccessibility="no"
        android:contentDescription="@null" />

    <!-- Left side vignette for title & text legibility -->
    <View
        android:id="@+id/heroSideScrim"
        android:layout_width="720dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@drawable/bg_hero_side_vignette" />

    <!-- Vertical cinematic scrim for top bar and bottom content rows -->
    <View
        android:id="@+id/heroScrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_hero_scrim" />

    <!-- Ambient glow from focused dock app (full screen radial) -->
    <View
        android:id="@+id/ambientGlow"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0" />

    <!-- ===== MAIN CONTENT SCROLL VIEW (Hero Info, Dock, Content Rows) ===== -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/mainContentRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingTop="72dp"
        android:paddingBottom="48dp"
        android:clipToPadding="false"
        android:clipChildren="false"
        android:overScrollMode="never"
        android:scrollbars="none"
        android:descendantFocusability="afterDescendants" />

    <!-- ===== TOP NAVIGATION BAR (Fixed top overlay for guaranteed visibility) ===== -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/top_bar_height"
        android:layout_gravity="top"
        android:background="@drawable/bg_top_bar_glass"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="@dimen/padding_screen_edge_lg"
        android:paddingEnd="@dimen/padding_screen_edge_lg"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:clipToPadding="false"
        android:clipChildren="false"
        android:elevation="16dp">

        <!-- Left block: Greeting + Live Clock + Date -->
        <LinearLayout
            android:id="@+id/leftBlock"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Greeting -->
            <TextView
                android:id="@+id/greeting"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="@dimen/text_size_greeting"
                android:textColor="@color/text_tertiary"
                android:fontFamily="@font/open_sans"
                android:letterSpacing="0.08"
                android:textAllCaps="true" />

            <!-- Clock & Date Row -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="2dp">

                <!-- Main clock -->
                <TextClock
                    android:id="@+id/clock"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:format12Hour="h:mm"
                    android:format24Hour="HH:mm"
                    android:textAppearance="@style/TextAppearance.TvHome.Clock"
                    android:includeFontPadding="false" />

                <!-- AM/PM -->
                <TextClock
                    android:id="@+id/ampm"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:format12Hour="a"
                    android:format24Hour=""
                    android:textAppearance="@style/TextAppearance.TvHome.Clock.AmPm"
                    android:includeFontPadding="false" />

                <!-- Divider dot -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="10dp"
                    android:text="•"
                    android:textColor="@color/border_subtle"
                    android:textSize="12sp" />

                <!-- Date -->
                <TextClock
                    android:id="@+id/date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:format12Hour="EEEE, MMMM d"
                    android:format24Hour="EEEE, MMMM d"
                    android:textSize="@dimen/text_size_date"
                    android:textColor="@color/text_secondary"
                    android:fontFamily="@font/open_sans"
                    android:includeFontPadding="false" />
            </LinearLayout>
        </LinearLayout>

        <!-- Right block: Top Utility & Discovery Buttons (Search, Store, Inputs, Wi-Fi, Settings) -->
        <LinearLayout
            android:id="@+id/topButtons"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Search button -->
            <TextView
                android:id="@+id/btnSearch"
                style="@style/TvHomeWidgetTopIconButton"
                android:contentDescription="@string/search"
                android:drawableStart="@drawable/ic_search"
                android:focusable="true"
                android:clickable="true"
                android:nextFocusDown="@+id/mainContentRecyclerView" />

            <!-- App Store button -->
            <TextView
                android:id="@+id/btnStore"
                style="@style/TvHomeWidgetTopIconButton"
                android:layout_marginStart="10dp"
                android:contentDescription="@string/app_store"
                android:drawableStart="@drawable/ic_store"
                android:focusable="true"
                android:clickable="true"
                android:nextFocusDown="@+id/mainContentRecyclerView" />

            <!-- Ambient Standby button -->
            <TextView
                android:id="@+id/btnAmbient"
                style="@style/TvHomeWidgetTopIconButton"
                android:layout_marginStart="10dp"
                android:contentDescription="Ambient Mode"
                android:drawableStart="@drawable/ic_wallpaper"
                android:focusable="true"
                android:clickable="true"
                android:nextFocusDown="@+id/mainContentRecyclerView" />

            <!-- Inputs button -->
            <TextView
                android:id="@+id/btnInputs"
                style="@style/TvHomeWidgetTopIconButton"
                android:layout_marginStart="10dp"
                android:contentDescription="@string/inputs"
                android:drawableStart="@drawable/ic_input"
                android:focusable="true"
                android:clickable="true"
                android:nextFocusDown="@+id/mainContentRecyclerView" />

            <!-- Wi-Fi button -->
            <TextView
                android:id="@+id/btnWifi"
                style="@style/TvHomeWidgetTopPillButton"
                android:layout_marginStart="10dp"
                android:text="@string/wifi"
                android:drawableStart="@drawable/ic_wifi"
                android:focusable="true"
                android:clickable="true"
                android:nextFocusDown="@+id/mainContentRecyclerView" />

            <!-- Settings button -->
            <TextView
                android:id="@+id/btnSettings"
                style="@style/TvHomeWidgetTopIconButton"
                android:layout_marginStart="10dp"
                android:contentDescription="@string/settings"
                android:drawableStart="@drawable/ic_settings"
                android:focusable="true"
                android:clickable="true"
                android:nextFocusDown="@+id/mainContentRecyclerView" />
        </LinearLayout>
    </LinearLayout>

    <!-- ===== FLOATING GLASS HIGHLIGHT ===== -->
    <com.gathin.tvhome.GlassView
        android:id="@+id/glass"
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:alpha="0"
        android:importantForAccessibility="no" />

    <!-- ===== APP LIBRARY GRID (hidden initially) ===== -->
    <FrameLayout
        android:id="@+id/gridContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:visibility="gone">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/grid"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingStart="@dimen/padding_screen_edge"
            android:paddingEnd="@dimen/padding_screen_edge"
            android:paddingTop="@dimen/space_4"
            android:paddingBottom="@dimen/space_8"
            android:clipToPadding="false"
            android:clipChildren="false"
            android:overScrollMode="never"
            android:scrollbars="none"
            android:descendantFocusability="afterDescendants" />
    </FrameLayout>
</FrameLayout>
