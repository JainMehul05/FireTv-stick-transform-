<?xml version="1.0" encoding="utf-8"?>
<!-- Premium Global Search Screen -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/searchRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_deep_navy"
    android:paddingStart="48dp"
    android:paddingEnd="48dp"
    android:paddingTop="32dp"
    android:paddingBottom="32dp">

    <!-- Top Search Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Search Input Field -->
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:background="@drawable/bg_search_input"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_search"
                    android:tint="@color/text_tertiary"
                    android:importantForAccessibility="no" />

                <EditText
                    android:id="@+id/searchQueryInput"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginStart="12dp"
                    android:background="@null"
                    android:hint="@string/search_hint"
                    android:textColorHint="@color/text_tertiary"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:fontFamily="@font/open_sans"
                    android:singleLine="true"
                    android:nextFocusDown="@+id/searchResultsGrid"
                    android:nextFocusRight="@+id/btnSearchBack"
                    android:imeOptions="actionSearch" />
            </LinearLayout>
        </FrameLayout>

        <!-- Back / Clear Button -->
        <TextView
            android:id="@+id/btnSearchBack"
            style="@style/TvHomeWidgetTopIconButton"
            android:layout_marginStart="16dp"
            android:contentDescription="@string/back"
            android:drawableStart="@drawable/ic_left"
            android:focusable="true"
            android:clickable="true"
            android:nextFocusLeft="@+id/searchQueryInput"
            android:nextFocusDown="@+id/searchResultsGrid" />
    </LinearLayout>

    <!-- Results Status / Section Header -->
    <TextView
        android:id="@+id/searchResultsHeader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="TOP MATCHES"
        android:textSize="12sp"
        android:textColor="@color/text_tertiary"
        android:fontFamily="@font/open_sans"
        android:letterSpacing="0.08"
        android:textAllCaps="true" />

    <!-- Results Grid -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/searchResultsGrid"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="12dp"
        android:clipToPadding="false"
        android:overScrollMode="never" />

</LinearLayout>
