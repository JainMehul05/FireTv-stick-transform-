<?xml version="1.0" encoding="utf-8"?>
<!-- Dock Section Item Layout - Apple TV Inspired Floating Glass Platter -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingTop="4dp"
    android:paddingBottom="16dp"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- Floating Dock Container with Glass Background Platter -->
    <FrameLayout
        android:id="@+id/dockPlatter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_dock_glass_surface"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="6dp"
        android:paddingBottom="10dp"
        android:clipChildren="false"
        android:clipToPadding="false">

        <!-- Floating Dock RecyclerView -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/dockRecyclerView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="horizontal"
            android:overScrollMode="never"
            android:scrollbars="none"
            android:clipToPadding="false"
            android:clipChildren="false"
            android:descendantFocusability="afterDescendants" />
    </FrameLayout>

    <!-- Dock focus indicator dot (positioned programmatically) -->
    <View
        android:id="@+id/dockDot"
        android:layout_width="6dp"
        android:layout_height="6dp"
        android:layout_gravity="center_horizontal|bottom"
        android:layout_marginBottom="4dp"
        android:alpha="0"
        android:background="@drawable/bg_dock_dot"
        android:importantForAccessibility="no" />

    <!-- Hero name tooltip above focused dock icon (positioned programmatically) -->
    <TextView
        android:id="@+id/heroName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal|top"
        android:layout_marginTop="-24dp"
        android:alpha="0"
        android:background="@drawable/bg_dock_label"
        android:paddingStart="@dimen/space_4"
        android:paddingEnd="@dimen/space_4"
        android:paddingTop="@dimen/space_2"
        android:paddingBottom="@dimen/space_2"
        android:textAppearance="@style/TextAppearance.TvHome.DockLabel"
        android:singleLine="true"
        android:ellipsize="end"
        android:maxWidth="220dp"
        android:elevation="6dp"
        android:importantForAccessibility="no" />
</FrameLayout>
