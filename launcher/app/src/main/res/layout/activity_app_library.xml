<?xml version="1.0" encoding="utf-8"?>
<!-- App Library Activity Layout -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_deep_navy"
    android:fitsSystemWindows="true">

    <!-- Background -->
    <ImageView
        android:id="@+id/libraryBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:importantForAccessibility="no"
        android:contentDescription="@null" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_hero_scrim" />

    <!-- Top Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/padding_screen_edge_lg"
        android:paddingEnd="@dimen/padding_screen_edge_lg"
        android:paddingTop="@dimen/margin_top_bar">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_4">

            <LinearLayout
                android:id="@+id/libraryLeftBlock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/libraryTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/apps"
                    android:textAppearance="@style/TextAppearance.TvHome.Display.Medium" />

                <TextView
                    android:id="@+id/librarySubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_1"
                    android:text="All Applications"
                    android:textAppearance="@style/TextAppearance.TvHome.Body"
                    android:textColor="@color/text_tertiary" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnLibraryBack"
                    style="@style/TvHomeWidgetTopIconButton"
                    android:contentDescription="@string/back"
                    android:drawableStart="@drawable/ic_left"
                    android:layout_marginEnd="@dimen/space_2" />

                <TextView
                    android:id="@+id/btnLibrarySearch"
                    style="@style/TvHomeWidgetTopIconButton"
                    android:contentDescription="@string/search"
                    android:drawableStart="@drawable/ic_search" />
            </LinearLayout>
        </RelativeLayout>
    </LinearLayout>

    <!-- Category Tabs -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/categoryTabs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_10"
        android:layout_marginStart="@dimen/padding_screen_edge_lg"
        android:layout_marginEnd="@dimen/padding_screen_edge_lg"
        android:orientation="horizontal"
        android:overScrollMode="never"
        android:scrollbars="none"
        android:clipToPadding="false"
        android:clipChildren="false"
        android:paddingBottom="@dimen/space_2" />

    <!-- App Grid -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/libraryGrid"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="@dimen/space_4"
        android:paddingStart="@dimen/padding_screen_edge"
        android:paddingEnd="@dimen/padding_screen_edge"
        android:paddingBottom="@dimen/space_8"
        android:clipToPadding="false"
        android:clipChildren="false"
        android:overScrollMode="never"
        android:scrollbars="none"
        android:descendantFocusability="afterDescendants" />

    <!-- Empty State -->
    <LinearLayout
        android:id="@+id/emptyState"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/space_20"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone"
        android:padding="@dimen/space_8">

        <ImageView
            android:layout_width="@dimen/icon_4xl"
            android:layout_height="@dimen/icon_4xl"
            android:src="@drawable/ic_system"
            android:tint="@color/text_quaternary"
            android:contentDescription="@null" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_4"
            android:text="No apps found"
            android:textAppearance="@style/TextAppearance.TvHome.Headline.Small"
            android:textColor="@color/text_secondary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_2"
            android:text="No leanback applications installed"
            android:textAppearance="@style/TextAppearance.TvHome.Body"
            android:textColor="@color/text_tertiary" />
    </LinearLayout>
</FrameLayout>