<?xml version="1.0" encoding="utf-8"?>
<!-- App Library Activity Layout -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_deep_navy"
    android:fitsSystemWindows="true">

    <!-- Background -->
    <ImageView
        android:id="@+id/libraryBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:importantForAccessibility="no"
        android:contentDescription="@null" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_hero_scrim" />

    <!-- Main Vertical Content Layout -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="@dimen/padding_screen_edge_lg"
        android:paddingEnd="@dimen/padding_screen_edge_lg"
        android:paddingTop="@dimen/margin_top_bar">

        <!-- Top Header Bar -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_2">

            <LinearLayout
                android:id="@+id/libraryLeftBlock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/libraryTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/apps"
                    android:textAppearance="@style/TextAppearance.TvHome.Display.Medium" />

                <TextView
                    android:id="@+id/librarySubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_1"
                    android:text="All Applications"
                    android:textAppearance="@style/TextAppearance.TvHome.Body"
                    android:textColor="@color/text_tertiary" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/searchEditText"
                    android:layout_width="260dp"
                    android:layout_height="42dp"
                    android:layout_marginEnd="@dimen/space_2"
                    android:background="@drawable/bg_search_input"
                    android:hint="@string/search"
                    android:textColorHint="@color/text_tertiary"
                    android:textColor="@color/text_primary"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:singleLine="true"
                    android:imeOptions="actionDone"
                    android:inputType="text"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/btnLibrarySearch"
                    style="@style/TvHomeWidgetTopIconButton"
                    android:contentDescription="@string/search"
                    android:drawableStart="@drawable/ic_search"
                    android:layout_marginEnd="@dimen/space_2" />

                <TextView
                    android:id="@+id/btnLibraryBack"
                    style="@style/TvHomeWidgetTopIconButton"
                    android:contentDescription="@string/back"
                    android:drawableStart="@drawable/ic_left" />
            </LinearLayout>
        </RelativeLayout>

        <!-- Category Tabs -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/categoryTabs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_2"
            android:orientation="horizontal"
            android:overScrollMode="never"
            android:scrollbars="none"
            android:clipToPadding="false"
            android:clipChildren="false"
            android:paddingBottom="@dimen/space_2" />

        <!-- Grid Container -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="@dimen/space_2">

            <!-- App Grid -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/libraryGrid"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingBottom="@dimen/space_8"
                android:clipToPadding="false"
                android:clipChildren="false"
                android:overScrollMode="never"
                android:scrollbars="none"
                android:descendantFocusability="afterDescendants" />

            <!-- Empty State -->
            <LinearLayout
                android:id="@+id/emptyState"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center"
                android:visibility="gone"
                android:padding="@dimen/space_8">

                <ImageView
                    android:layout_width="@dimen/icon_4xl"
                    android:layout_height="@dimen/icon_4xl"
                    android:src="@drawable/ic_system"
                    android:tint="@color/text_quaternary"
                    android:contentDescription="@null" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_4"
                    android:text="No apps found"
                    android:textAppearance="@style/TextAppearance.TvHome.Headline.Small"
                    android:textColor="@color/text_secondary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_2"
                    android:text="No applications found in this category"
                    android:textAppearance="@style/TextAppearance.TvHome.Body"
                    android:textColor="@color/text_tertiary" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
