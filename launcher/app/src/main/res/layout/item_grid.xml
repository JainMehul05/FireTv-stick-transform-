<?xml version="1.0" encoding="utf-8"?>
<!-- Premium Grid Item Layout (App Library) -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:padding="@dimen/space_2">

    <!-- Drop shadow (positioned behind the card) -->
    <View
        android:id="@+id/shadow"
        android:layout_width="@dimen/grid_item_width"
        android:layout_height="@dimen/grid_item_height"
        android:layout_gravity="center_horizontal|top"
        android:layout_marginTop="@dimen/space_3"
        android:background="@drawable/bg_grid_shadow"
        android:alpha="0.3"
        android:visibility="visible"
        android:importantForAccessibility="no" />

    <!-- Main card -->
    <FrameLayout
        android:id="@+id/card"
        android:layout_width="@dimen/grid_item_width"
        android:layout_height="@dimen/grid_item_height"
        android:layout_gravity="center_horizontal|top"
        android:background="@drawable/bg_grid_item"
        android:focusable="true"
        android:clickable="true"
        android:clipToOutline="true">

        <!-- App icon -->
        <ImageView
            android:id="@+id/icon"
            android:layout_width="@dimen/icon_grid"
            android:layout_height="@dimen/icon_grid"
            android:layout_gravity="center_horizontal|top"
            android:layout_marginTop="@dimen/space_5"
            android:contentDescription="@null" />

        <!-- App name label -->
        <TextView
            android:id="@+id/name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_marginTop="@dimen/space_2"
            android:paddingStart="@dimen/space_3"
            android:paddingEnd="@dimen/space_3"
            android:paddingBottom="@dimen/space_4"
            android:gravity="center"
            android:singleLine="true"
            android:ellipsize="end"
            android:textAppearance="@style/TextAppearance.TvHome.CardLabel"
            android:alpha="0"
            android:translationY="@dimen/space_2" />
    </FrameLayout>
</FrameLayout>