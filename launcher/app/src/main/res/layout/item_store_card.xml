<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/storeCard"
    android:layout_width="match_parent"
    android:layout_height="90dp"
    android:layout_margin="6dp"
    android:background="@drawable/bg_dock_glass_surface"
    android:focusable="true"
    android:clickable="true"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- App Icon -->
        <ImageView
            android:id="@+id/storeAppIcon"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:scaleType="fitCenter"
            android:background="@drawable/bg_top_icon_button"
            android:padding="6dp"
            android:importantForAccessibility="no" />

        <!-- App Details -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="14dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/storeAppName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="App Name"
                    android:textSize="15sp"
                    android:textColor="@color/text_primary"
                    android:fontFamily="@font/open_sans"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/storeAppCategory"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="STREAMING"
                    android:textSize="10sp"
                    android:textColor="@color/accent_electric_blue"
                    android:fontFamily="@font/open_sans"
                    android:letterSpacing="0.06"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/storeAppDesc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Description of the application goes here."
                android:textSize="11sp"
                android:textColor="@color/text_secondary"
                android:fontFamily="@font/open_sans"
                android:singleLine="true"
                android:ellipsize="end" />
        </LinearLayout>

        <!-- Action Pill (OPEN or GET) -->
        <TextView
            android:id="@+id/storeAppAction"
            style="@style/TvHomeWidgetTopPillButton"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginStart="10dp"
            android:text="GET"
            android:textSize="11sp"
            android:textStyle="bold"
            android:focusable="false" />
    </LinearLayout>
</FrameLayout>
