<?xml version="1.0" encoding="utf-8"?>
<!-- Hero Section Foreground Item Layout - Cinematic Title & Metadata -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/heroContentContainer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/padding_screen_edge_lg"
    android:paddingEnd="@dimen/padding_screen_edge_lg"
    android:paddingTop="8dp"
    android:paddingBottom="16dp"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- Category badge -->
    <TextView
        android:id="@+id/heroCategory"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/featured"
        android:textAppearance="@style/TextAppearance.TvHome.Overline"
        android:textColor="@color/accent_electric_blue"
        android:letterSpacing="0.14"
        android:layout_marginBottom="4dp" />

    <!-- Hero title -->
    <TextView
        android:id="@+id/heroTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/hero_featured_title"
        android:textAppearance="@style/TextAppearance.TvHome.Display.Small"
        android:textColor="@color/text_primary"
        android:maxWidth="720dp"
        android:maxLines="2"
        android:ellipsize="end"
        android:layout_marginBottom="6dp" />

    <!-- Hero metadata row -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp">

        <!-- Year -->
        <TextView
            android:id="@+id/heroYear"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="2024"
            android:textAppearance="@style/TextAppearance.TvHome.Body"
            android:textColor="@color/text_secondary" />

        <!-- Dot separator -->
        <View
            android:layout_width="4dp"
            android:layout_height="4dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/dot_separator" />

        <!-- Genre -->
        <TextView
            android:id="@+id/heroGenre"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sci-Fi / Adventure"
            android:textAppearance="@style/TextAppearance.TvHome.Body"
            android:textColor="@color/text_secondary" />

        <!-- Dot separator -->
        <View
            android:layout_width="4dp"
            android:layout_height="4dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/dot_separator" />

        <!-- Duration -->
        <TextView
            android:id="@+id/heroDuration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="2h 46m"
            android:textAppearance="@style/TextAppearance.TvHome.Body"
            android:textColor="@color/text_secondary" />

        <!-- 4K HDR badge -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_badge_4k"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:text="4K HDR"
            android:textAppearance="@style/TextAppearance.TvHome.Caption"
            android:textColor="@color/text_tertiary" />
    </LinearLayout>

    <!-- Action buttons -->
    <LinearLayout
        android:id="@+id/heroActions"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:descendantFocusability="afterDescendants">

        <!-- Play/Watch button -->
        <TextView
            android:id="@+id/heroPlayButton"
            style="@style/TvHomeWidgetGlassButton"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginEnd="12dp"
            android:drawableStart="@drawable/ic_play"
            android:drawablePadding="8dp"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:gravity="center"
            android:text="@string/play"
            android:focusable="true"
            android:clickable="true" />

        <!-- More Info button -->
        <TextView
            android:id="@+id/heroInfoButton"
            style="@style/TvHomeWidgetGlassButton"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:drawableStart="@drawable/ic_info"
            android:drawablePadding="8dp"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:gravity="center"
            android:text="@string/more_info"
            android:focusable="true"
            android:clickable="true" />
    </LinearLayout>
</LinearLayout>
