<?xml version="1.0" encoding="utf-8"?>
<!-- Settings Activity Layout -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_deep_navy"
    android:fitsSystemWindows="true">

    <!-- Background -->
    <ImageView
        android:id="@+id/settingsBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:importantForAccessibility="no"
        android:contentDescription="@null" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_hero_scrim" />

    <!-- Top Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/padding_screen_edge_lg"
        android:paddingEnd="@dimen/padding_screen_edge_lg"
        android:paddingTop="@dimen/margin_top_bar">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_4">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings"
                    android:textAppearance="@style/TextAppearance.TvHome.Display.Medium" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_1"
                    android:text="Launcher preferences"
                    android:textAppearance="@style/TextAppearance.TvHome.Body"
                    android:textColor="@color/text_tertiary" />
            </LinearLayout>

            <TextView
                android:id="@+id/btnSettingsBack"
                style="@style/TvHomeWidgetTopIconButton"
                android:layout_alignParentEnd="true"
                android:contentDescription="@string/back"
                android:drawableStart="@drawable/ic_left" />
        </RelativeLayout>
    </LinearLayout>

    <!-- Settings List -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/settingsList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="@dimen/space_8"
        android:paddingStart="@dimen/padding_screen_edge"
        android:paddingEnd="@dimen/padding_screen_edge"
        android:paddingBottom="@dimen/space_8"
        android:clipToPadding="false"
        android:clipChildren="false"
        android:overScrollMode="never"
        android:scrollbars="none"
        android:descendantFocusability="afterDescendants" />
</FrameLayout>