<?xml version="1.0" encoding="utf-8"?>
<!-- Apps Row Item Layout -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/appsRow"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="@dimen/space_6"
    android:paddingEnd="@dimen/space_4"
    android:paddingTop="@dimen/space_3"
    android:paddingBottom="@dimen/space_3"
    android:focusable="true"
    android:clickable="true"
    android:background="@drawable/bg_glass_button">

    <!-- Apps icon -->
    <ImageView
        android:layout_width="@dimen/icon_lg"
        android:layout_height="@dimen/icon_lg"
        android:layout_marginEnd="@dimen/space_3"
        android:src="@drawable/ic_system"
        android:tint="@color/accent_electric_blue"
        android:contentDescription="@null" />

    <!-- Apps label -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/apps"
        android:textAppearance="@style/TextAppearance.TvHome.Headline.Small"
        android:textColor="@color/text_primary" />

    <!-- Chevron indicator -->
    <ImageView
        android:layout_width="@dimen/icon_md"
        android:layout_height="@dimen/icon_md"
        android:layout_marginStart="@dimen/space_4"
        android:src="@drawable/ic_right"
        android:tint="@color/text_tertiary"
        android:contentDescription="@null" />
</LinearLayout>