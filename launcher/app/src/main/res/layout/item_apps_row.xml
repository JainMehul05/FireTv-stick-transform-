<?xml version="1.0" encoding="utf-8"?>
<!-- Premium All Apps / App Library Discovery Banner Card -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/padding_screen_edge_lg"
    android:paddingEnd="@dimen/padding_screen_edge_lg"
    android:paddingTop="12dp"
    android:paddingBottom="40dp"
    android:clipChildren="false"
    android:clipToPadding="false">

    <LinearLayout
        android:id="@+id/appsRow"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:focusable="true"
        android:clickable="true"
        android:background="@drawable/bg_glass_button">

        <!-- Apps grid icon -->
        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginEnd="16dp"
            android:src="@drawable/ic_system"
            android:tint="@color/accent_electric_blue"
            android:contentDescription="@null" />

        <!-- Texts -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/browse_all"
                android:textAppearance="@style/TextAppearance.TvHome.Title.Medium"
                android:textColor="@color/text_primary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Explore all installed applications, games &amp; streaming services"
                android:textAppearance="@style/TextAppearance.TvHome.Caption"
                android:textColor="@color/text_tertiary" />
        </LinearLayout>

        <!-- Chevron indicator -->
        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_right"
            android:tint="@color/accent_electric_blue"
            android:contentDescription="@null" />
    </LinearLayout>
</FrameLayout>
